{
  "nodeModulesDir": "none",
  "imports": {
    "/libs/": "./src/libs/",
    "/components/": "./src/components/",
    "@cliffy/command": "jsr:@cliffy/command",
    "@cliffy/keypress": "jsr:@cliffy/keypress",
    "@cliffy/prompt": "jsr:@cliffy/prompt"
  },
  "tasks": {
    "lume": "deno run --import-map=import_map.json -A lume/cli.ts",
    "build": "deno task lume",
    "serve": "deno task lume -s",
    "reel": "deno run -A --location 'https://meetlitis.com?monitor=$reel,$updated' ./src/libs/reel/cli.js QDaitfgARpk -i"
  },
  "lint": {
    "rules": {
      "exclude": ["no-unused-vars"]
    }
  },
  "compilerOptions": {
    "types": [
      "lume/types.ts"
    ]
  }
}
